# Copy this file to .env.local and fill in values. NEVER commit .env.local.
# `bash setup.sh` does the copy for you.
#
# The app works WITHOUT any of these (demo mode: no login, data kept in memory).
# Add the two Supabase values below to switch on real accounts and a real database.
# See README.md, section "Connect Supabase".
#
# Only variables starting with NEXT_PUBLIC_ are visible in the browser.
# Everything else stays on the server.

# Supabase dashboard -> Project Settings -> API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (older projects call it the "anon" key). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the Supabase "service role" or "secret" key in this project's client code,
# and never prefix it with NEXT_PUBLIC_. The app does not need it.
